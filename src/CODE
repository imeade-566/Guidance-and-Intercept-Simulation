function txt = SimulationDataTip(event_obj, Log_Time, Log_Missile_X, Log_Missile_Y, Log_Plane_X, Log_Plane_Y, Log_Distance, Log_LOS_Blocked)

pos = event_obj.Position;

% Find closest logged point by spatial distance to click
Dist_To_Missile = hypot(Log_Missile_X - pos(1), Log_Missile_Y - pos(2));
Dist_To_Plane   = hypot(Log_Plane_X   - pos(1), Log_Plane_Y   - pos(2));

[d_m, idx_m] = min(Dist_To_Missile);
[d_p, idx_p] = min(Dist_To_Plane);

% Use whichever trajectory the click is closest to
if d_m <= d_p
    idx = idx_m;
    agent = 'Missile';
else
    idx = idx_p;
    agent = 'Plane';
end

txt = {
    ['Nearest: ', agent]
    ['Time: ',     num2str(Log_Time(idx),     '%.2f'), ' s']
    ['Missile: (', num2str(Log_Missile_X(idx),'%.2f'), ', ', num2str(Log_Missile_Y(idx),'%.2f'), ')']
    ['Plane:   (', num2str(Log_Plane_X(idx),  '%.2f'), ', ', num2str(Log_Plane_Y(idx),  '%.2f'), ')']
    ['Distance: ', num2str(Log_Distance(idx), '%.2f'), ' m']
    ['LOS Blocked: ', char(string(Log_LOS_Blocked(idx)))]
    };
end

function shadeLOS(Log_Time, Log_LOS_Blocked, Step, yLims)
LOS_Diff    = diff([0 Log_LOS_Blocked 0]);
Shade_Start = find(LOS_Diff ==  1);
Shade_End   = find(LOS_Diff == -1) - 1;

for b = 1:length(Shade_Start)
    T1 = Log_Time(Shade_Start(b));
    T2 = Log_Time(min(Shade_End(b), Step));

    patch([T1 T2 T2 T1], [yLims(1) yLims(1) yLims(2) yLims(2)], [1 0.85 0.6], 'EdgeColor', 'none', 'FaceAlpha', 0.35);
end
end



