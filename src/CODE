function Vout = TransformSTL3D(V, Position3D, Heading, Scale, Axis_Order, Pre_Rotation)

V = V(:, Axis_Order);
V = V * Scale;

Rx = [1, 0, 0;
      0, cos(Pre_Rotation(1)), -sin(Pre_Rotation(1));
      0, sin(Pre_Rotation(1)),  cos(Pre_Rotation(1))];

Ry = [ cos(Pre_Rotation(2)), 0, sin(Pre_Rotation(2));
       0,                    1, 0;
      -sin(Pre_Rotation(2)), 0, cos(Pre_Rotation(2))];

Rz_pre = [cos(Pre_Rotation(3)), -sin(Pre_Rotation(3)), 0;
          sin(Pre_Rotation(3)),  cos(Pre_Rotation(3)), 0;
          0,                     0,                    1];

Rz_heading = [cos(Heading), -sin(Heading), 0;
              sin(Heading),  cos(Heading), 0;
              0,             0,            1];

V = V * Rx';
V = V * Ry';
V = V * Rz_pre';
V = V * Rz_heading';

Vout = V + Position3D';

end

