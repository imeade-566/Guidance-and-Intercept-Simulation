                Dist_Vals(r) = R.Final_Distance;
                Dur_Vals(r)  = R.Duration;
                Trajectory_Results{ni, ai, r} = R;
            end

            Success_Grid(ni, ai)   = Successes  / Runs_Per_Combo * 100;
            Collision_Grid(ni, ai) = Collisions / Runs_Per_Combo * 100;
            MeanG_Grid(ni, ai)     = mean(G_Vals);
            MeanDist_Grid(ni, ai)  = mean(Dist_Vals);
            MeanDur_Grid(ni, ai)   = mean(Dur_Vals);

            fprintf('N=%.1f  APF=%.1f  ->  Success: %.0f%%  Collision: %.0f%%  MeanG: %.1f  MeanDist: %.1f  MeanDur: %.1fs\n', Nav_Values(ni), APF_Values(ai), Success_Grid(ni,ai), Collision_Grid(ni,ai), MeanG_Grid(ni,ai), MeanDist_Grid(ni,ai), MeanDur_Grid(ni,ai));
