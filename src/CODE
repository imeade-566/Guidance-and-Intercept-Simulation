clc; clear; close all;

%% ========================================================================
% FEATURE TOGGLES 
% =========================================================================

Default_Flags.Use_Data_Cursor    = false;
Default_Flags.Use_Dashboard      = false;
Default_Flags.Use_Live_Animation = false;
Default_Flags.Use_LOS_Shading    = false;
Default_Flags.Camera_Follow      = false;
Default_Flags.Use_STL_Models     = false;
Default_Flags.Run_Batch_Tuning   = false;
Default_Flags.Use_3D_View        = false;

if isfile('SimFlags.mat')
    load('SimFlags.mat', 'Flags');

    Default_Field_Names = fieldnames(Default_Flags);
    for fi = 1:length(Default_Field_Names)
        if ~isfield(Flags, Default_Field_Names{fi})
            Flags.(Default_Field_Names{fi}) = Default_Flags.(Default_Field_Names{fi});
        end
    end
else
    Flags = Default_Flags;
end

Flags = FlagToggleGUI(Flags);

%% ========================================================================
% SECTION 1: PARAMETERS
% =========================================================================

Delta_Time              = 0.05;
Plane_Heading           = rand * 2*pi;
Plane_Max_Turn_Rate     = pi/1.5;
Plane_Noise_Weight      = 0.15;
Plane_Start             = randi([0, 1200], 2, 1);
Close_Range             = 250.0;
Jink_Period             = 4.5;
Missile_Start           = [0; 0];
Missile_Boundary_Margin = 60.0;
Missile_Boundary_Gain   = 500.0;
Boundary_Margin         = 80.0;
Gain_Repulsive          = 500.0;
Influence_Radius        = 60.0;
Arena_Buffer            = 50;
Replay_Speed            = 1.0;
Animation_Step          = 3;

Settings = SimulationSetupGUI(20.0, 40.0, 100.0, 10, 35, 20.0);

Plane_Speed    = Settings.Plane_Speed;
Missile_Speed  = Settings.Missile_Speed;
Max_Time       = Settings.Max_Time;
Num_Obstacles  = round(Settings.Num_Obstacles);
Missile_G_Max  = Settings.Missile_G_Max;
Capture_Radius = Settings.Capture_Radius;
Arena_Z_Max = 500;

% --- Pack params for batch tuning (must be after all values are defined) ---
Params.Delta_Time              = Delta_Time;
Params.Plane_Heading           = Plane_Heading;
Params.Plane_Max_Turn_Rate     = Plane_Max_Turn_Rate;
Params.Plane_Noise_Weight      = Plane_Noise_Weight;
Params.Close_Range             = Close_Range;
Params.Jink_Period             = Jink_Period;
Params.Missile_Start           = Missile_Start;
Params.Missile_Boundary_Margin = Missile_Boundary_Margin;
Params.Missile_Boundary_Gain   = Missile_Boundary_Gain;
Params.Boundary_Margin         = Boundary_Margin;
Params.Gain_Repulsive          = Gain_Repulsive;
Params.Influence_Radius        = Influence_Radius;
Params.Arena_Buffer            = Arena_Buffer;
Params.Min_Separation          = 150;

% Arena Size
Initial_Separation     = norm(Plane_Start - Missile_Start);
Closing_Speed_Estimate = Missile_Speed - Plane_Speed;
if Closing_Speed_Estimate <= 0
    error('Missile speed must exceed plane speed.');
end

Missile_Model_File = 'AIM-120A_AMRAAM_MODEL.stl';
Model_Scale.Missile          = .5;
Model_Heading_Offset.Missile = 0;
Plane_Model_File = 'F16_BLOCK50_MODEL.stl';
Model_Scale.Plane          = .5;    
Model_Heading_Offset.Plane = pi;      
SAM_Model_File = 'PATRIOT_PAC3_MODEL.stl';
Model_Scale.SAM = 10;          
Model_Heading_Offset.SAM = 0;   
SAM_Position = Missile_Start;
SAM_Heading = 0;
Model_Axis_Order.Missile = [3 1 2];
Model_Axis_Order.Plane   = [2 1 3];
Model_Pre_Rotation.Missile = [-pi/2, 0, 0];
Model_Pre_Rotation.Plane = [0, 0, 0];

if Flags.Use_STL_Models
    % Missile STL
    STL = stlread(Missile_Model_File);
    Missile_Vertices = STL.Points;
    Missile_Faces    = STL.ConnectivityList;
    Missile_Vertices = Missile_Vertices - mean(Missile_Vertices, 1);

    % Plane STL
    STL = stlread(Plane_Model_File);
    Plane_Vertices = STL.Points;
    Plane_Faces    = STL.ConnectivityList;
    Plane_Vertices = Plane_Vertices - mean(Plane_Vertices, 1);
    Model_Heading_Offset.Plane = pi;

    % SAM / PAC-3 STL
    STL = stlread(SAM_Model_File);
    SAM_Vertices = STL.Points;
    SAM_Faces    = STL.ConnectivityList;
    SAM_Vertices = SAM_Vertices - mean(SAM_Vertices, 1);
end



if Flags.Use_STL_Models
    fprintf('STL size: X=%.1f  Y=%.1f  Z=%.1f\n', max(Missile_Vertices(:,1)) - min(Missile_Vertices(:,1)), max(Missile_Vertices(:,2)) - min(Missile_Vertices(:,2)), max(Missile_Vertices(:,3)) - min(Missile_Vertices(:,3)));
end

Estimated_Intercept_Time = Initial_Separation / Closing_Speed_Estimate;
Arena_Size = ceil(max([Missile_Start; Plane_Start])) + ceil(max(Missile_Speed, Plane_Speed) * Estimated_Intercept_Time) + Arena_Buffer;

%% ========================================================================
% SECTION 2: GENERATE RANDOM OBSTACLES
% =========================================================================


Obs_Radius_Min = 5;
Obs_Radius_Max = 50;
rng('shuffle');

Obstacle_Center = zeros(3, Num_Obstacles);
Obstacle_Radius = zeros(1, Num_Obstacles);
Clearance = 20.0;
Count     = 0;
Attempts  = 0;

while Count < Num_Obstacles && Attempts < 5000
    Attempts = Attempts + 1;

    R  = Obs_Radius_Min + (Obs_Radius_Max - Obs_Radius_Min) * rand();
    Cx = R + (Arena_Size - 2*R) * rand();
    Cy = R + (Arena_Size - 2*R) * rand();

    if Flags.Use_3D_View
        Cz = R + (Arena_Z_Max - 2*R) * rand();
    else
        Cz = 0;
    end

    C = [Cx; Cy; Cz];

    if norm(C(1:2) - Missile_Start) < Clearance + R, continue; end
    if norm(C(1:2) - Plane_Start) < Clearance + R, continue; end

    Overlap = false;
    for k = 1:Count
        if norm(C(1:2) - Obstacle_Center(1:2,k)) < R + Obstacle_Radius(k) + 4
            Overlap = true; break;
        end
    end
    if Overlap, continue; end

    Count = Count + 1;
    Obstacle_Center(:, Count) = C;
    Obstacle_Radius(Count)    = R;
end

Num_Obstacles = Count;
fprintf('Placed %d obstacles.\n', Num_Obstacles);

%% ========================================================================
% SECTION 3: INITIALISE STATE
% =========================================================================

Missile_Position  = Missile_Start;
Plane_Position    = Plane_Start;
Plane_Velocity    = Plane_Speed * [cos(Plane_Heading); sin(Plane_Heading)];
Plane_Noise_Angle = 0.0;
Smoothed_Evasion = [cos(Plane_Heading); sin(Plane_Heading)];
Missile_Z = 0;
Plane_Z   = 50 + 350 * rand();
Plane_Z_Velocity = -10 + 20 * rand();
Plane_Z_Max_Accel = 12;
Missile_Z_Velocity = 0;
Missile_Z_Max_Accel = 8;
Missile_Z_Max_Speed = 35;

Initial_Vector  = Plane_Start - Missile_Start;
Missile_Heading = atan2(Initial_Vector(2), Initial_Vector(1));

Last_Plane_Position = Plane_Position;
Last_Plane_Velocity = Plane_Velocity;
Occlusion_Timer     = 0.0;

Max_Steps       = ceil(Max_Time / Delta_Time);
Log_Missile_X   = nan(1, Max_Steps);
Log_Missile_Y   = nan(1, Max_Steps);
Log_Plane_X     = nan(1, Max_Steps);
Log_Plane_Y     = nan(1, Max_Steps);
Log_Distance    = nan(1, Max_Steps);
Log_Time        = nan(1, Max_Steps);
Log_LOS_Blocked = false(1, Max_Steps);
Log_Missile_G   = nan(1, Max_Steps);

%% ========================================================================
% SECTION 4: MAIN SIMULATION LOOP
% =========================================================================

Step         = 0;
Current_Time = 0.0;
Intercept    = false;
Keep_Running = true;

if Flags.Use_Live_Animation
    Sim_Fig = figure('Name', 'Live Simulation', 'Color', 'k');
    hold on; grid on;
    axis normal;
    pbaspect([1 1 0.45]);
    if Flags.Use_3D_View
        view(3);
        zlabel('Z (m)');
        zlim([0 Arena_Z_Max]);
    else
        view(2);
    end
    lighting gouraud
    camlight('headlight')
    material dull

    set(gca, 'Color', [0.05 0.05 0.05]);
    set(gca, 'GridColor', [0.5 0.5 0.5]);
    xlabel('X (m)');
    ylabel('Y (m)');
    title('Live Intercept Simulation');
    xlim([0 Arena_Size]);
    ylim([0 Arena_Size]);

    if Flags.Use_3D_View
        zlim([0 Arena_Z_Max]);
    end

    for i = 1:Num_Obstacles
        if Flags.Use_3D_View
            [Xs, Ys, Zs] = sphere(24);
            surf(Obstacle_Center(1,i) + Obstacle_Radius(i)*Xs, Obstacle_Center(2,i) + Obstacle_Radius(i)*Ys, Obstacle_Center(3,i) + Obstacle_Radius(i)*Zs, 'FaceColor', [0.75 0.75 0.75], 'EdgeColor', 'none', 'FaceAlpha', 0.55);
        else
            th = linspace(0, 2*pi, 60);
            fill(Obstacle_Center(1,i) + Obstacle_Radius(i)*cos(th), Obstacle_Center(2,i) + Obstacle_Radius(i)*sin(th), [0.75 0.75 0.75], 'EdgeColor', [0.5 0.5 0.5]);
        end
    end

    Missile_Trail = animatedline('Color', [0.0 0.6 0.8], 'LineWidth', 1.2);
    Plane_Trail   = animatedline('Color', 'y', 'LineWidth', 2.0);
    LOS_Line      = plot3([0 0], [0 0], [0 0], 'g-', 'LineWidth', 1);

    Missile_Marker = plot3(Missile_Position(1), Missile_Position(2), 0, 'co', 'MarkerFaceColor', 'c', 'MarkerSize', 8, 'Visible', 'off');
    Plane_Marker   = plot3(Plane_Position(1),   Plane_Position(2),   0, 'y^', 'MarkerFaceColor', 'y', 'MarkerSize', 8, 'Visible', 'off');

    if Flags.Use_STL_Models
        
        Missile_Model = patch('Faces', Missile_Faces, 'Vertices', TransformSTL3D( Missile_Vertices, [Missile_Position(1); Missile_Position(2); 0], Missile_Heading + Model_Heading_Offset.Missile, Model_Scale.Missile, Model_Axis_Order.Missile, Model_Pre_Rotation.Missile), 'FaceColor', [0.9 0.15 0.05], 'EdgeColor', 'none', 'FaceLighting', 'gouraud');
        uistack(Missile_Model, 'top');
        Plane_Model = patch('Faces', Plane_Faces, 'Vertices', TransformSTL3D(Plane_Vertices, [Plane_Position(1); Plane_Position(2); 0], Plane_Heading + Model_Heading_Offset.Plane, Model_Scale.Plane, Model_Axis_Order.Plane, Model_Pre_Rotation.Plane), 'FaceColor', [0.45 0.45 0.45], 'EdgeColor', 'none', 'FaceLighting', 'gouraud');
        uistack(Plane_Model, 'top');
        SAM_Model = patch('Faces', SAM_Faces, 'Vertices', TransformSAMSTL2D(SAM_Vertices, SAM_Position, SAM_Heading + Model_Heading_Offset.SAM, Model_Scale.SAM), 'FaceColor', [0.25 0.35 0.25], 'EdgeColor', 'none', 'FaceLighting', 'gouraud', 'AmbientStrength', 0.45, 'DiffuseStrength', 0.65, 'SpecularStrength', 0.1);
        uistack(SAM_Model, 'bottom');
    
    end
    
    Camera_Center = Missile_Position;
    Follow_Window = 300;

end

while Keep_Running && Step < Max_Steps
    Step         = Step + 1;
    Current_Time = Step * Delta_Time;

    % --- PLANE EVASION ---
    Missile_to_Plane_Vector   = Plane_Position - Missile_Position;
    Missile_to_Plane_Distance = norm(Missile_to_Plane_Vector) + 1e-9;
    LOS_Unit                  = Missile_to_Plane_Vector / Missile_to_Plane_Distance;

    Boundary_Force    = [0; 0];
    Boundary_Force(1) = Boundary_Force(1) + max(0, 1 - Plane_Position(1) / Boundary_Margin);
    Boundary_Force(1) = Boundary_Force(1) - max(0, 1 - (Arena_Size - Plane_Position(1)) / Boundary_Margin);
    Boundary_Force(2) = Boundary_Force(2) + max(0, 1 - Plane_Position(2) / Boundary_Margin);
    Boundary_Force(2) = Boundary_Force(2) - max(0, 1 - (Arena_Size - Plane_Position(2)) / Boundary_Margin);

    Plane_Obstacle_Force = [0; 0];
    
    for i = 1:Num_Obstacles
        Vec_Away = Plane_Position - Obstacle_Center(1:2,i);
        Dist_Center  = norm(Vec_Away) + 1e-9;
        Dist_Surface = max(Dist_Center - Obstacle_Radius(i), 0.01);
        if Dist_Surface < Influence_Radius
            Unit_Away = Vec_Away / Dist_Center;
            Rep_Mag   = 300 * (1/Dist_Surface - 1/Influence_Radius) / Dist_Surface^2;
            Plane_Obstacle_Force = Plane_Obstacle_Force + Rep_Mag * Unit_Away;
        end
    end

    Perp_A = [-LOS_Unit(2);  LOS_Unit(1)];
    Perp_B = [ LOS_Unit(2); -LOS_Unit(1)];
    Current_Direction = [cos(Plane_Heading); sin(Plane_Heading)];

    if dot(Perp_A, Current_Direction) >= dot(Perp_B, Current_Direction)
        Base_Beam_Direction = Perp_A;
    else
        Base_Beam_Direction = Perp_B;
    end

    Jink_Bias      = 0.65 + 0.35 * sin(2 * pi * Current_Time / Jink_Period);
    Beam_Direction = Jink_Bias * Base_Beam_Direction;
    Beam_Direction = Beam_Direction / (norm(Beam_Direction) + 1e-9);

    Away_Weight = max(0.15, 0.9 * (1 - Missile_to_Plane_Distance / Close_Range));

    Plane_Noise_Angle = 0.96 * Plane_Noise_Angle + 0.04 * randn();
    Noise_Direction   = [cos(Plane_Noise_Angle); sin(Plane_Noise_Angle)];

    Plane_Evasion_Vector    = 0.6 * Beam_Direction + Away_Weight * LOS_Unit + Plane_Noise_Weight * Noise_Direction + 1.5 * Boundary_Force + 0.6 * Plane_Obstacle_Force;
    Smoothed_Evasion = 0.75 * Smoothed_Evasion + 0.25 * Plane_Evasion_Vector;
    Plane_Desired_Direction = Smoothed_Evasion / (norm(Smoothed_Evasion) + 1e-9);

    Plane_Desired_Heading = atan2(Plane_Desired_Direction(2), Plane_Desired_Direction(1));
    Plane_Heading_Error   = atan2(sin(Plane_Desired_Heading - Plane_Heading), cos(Plane_Desired_Heading - Plane_Heading));
    Plane_Max_Turn_Step   = Plane_Max_Turn_Rate * Delta_Time;
    Plane_Heading         = Plane_Heading + sign(Plane_Heading_Error) * min(abs(Plane_Heading_Error), Plane_Max_Turn_Step);

    Plane_Velocity = Plane_Speed * [cos(Plane_Heading); sin(Plane_Heading)];
    Plane_Position = Plane_Position + Plane_Velocity * Delta_Time;


    if Flags.Use_3D_View
        Plane_Z_Accel = Plane_Z_Max_Accel * (2*rand - 1);

        Plane_Z_Velocity = Plane_Z_Velocity + Plane_Z_Accel * Delta_Time;
        Plane_Z_Velocity = max(min(Plane_Z_Velocity, 45), -45);

        Plane_Z = Plane_Z + Plane_Z_Velocity * Delta_Time;

        if Plane_Z < 20
            Plane_Z = 20;
            Plane_Z_Velocity = abs(Plane_Z_Velocity);
        elseif Plane_Z > Arena_Z_Max - 20
            Plane_Z = Arena_Z_Max - 20;
            Plane_Z_Velocity = -abs(Plane_Z_Velocity);
        end

        Altitude_Error = Plane_Z - Missile_Z;

        Missile_Z_Accel = 0.15 * Altitude_Error - 0.5 * Missile_Z_Velocity;
        Missile_Z_Accel = max(min(Missile_Z_Accel, 12), -12);

        Missile_Z_Velocity = Missile_Z_Velocity + Missile_Z_Accel * Delta_Time;
        Missile_Z_Velocity = max(min(Missile_Z_Velocity, 35), -35);

        Missile_Z = Missile_Z + Missile_Z_Velocity * Delta_Time;
        Missile_Z = max(0, min(Arena_Z_Max, Missile_Z));
   
    else
        Plane_Z = 0;
        Missile_Z = 0;
    end

    % --- LOS CHECK ---
    LOS_Blocked = false;

    Missile_Position_3D = [Missile_Position(1); Missile_Position(2); Missile_Z];
    Plane_Position_3D   = [Plane_Position(1);   Plane_Position(2);   Plane_Z];

    Segment_Vec_3D = Plane_Position_3D - Missile_Position_3D;

    for i = 1:Num_Obstacles
        To_Obstacle_3D = Obstacle_Center(:,i) - Missile_Position_3D;
        Projection = dot(To_Obstacle_3D, Segment_Vec_3D) / (dot(Segment_Vec_3D, Segment_Vec_3D) + 1e-9);
        Projection = max(0, min(1, Projection));
        Closest_Point_3D = Missile_Position_3D + Projection * Segment_Vec_3D;
        Distance_To_LOS = norm(Obstacle_Center(:,i) - Closest_Point_3D);
        LOS_Clearance_Buffer = 5;

        if Distance_To_LOS < Obstacle_Radius(i) + LOS_Clearance_Buffer
            LOS_Blocked = true;
            break;
        end
    end
    
    LOS_Z = [0, 0];
    if Flags.Use_3D_View
        LOS_Z = [Missile_Z, Plane_Z];
    end
    

    % --- GUIDANCE TARGET SELECTION ---
    if ~LOS_Blocked
        Guidance_Target_Position = Plane_Position;
        Guidance_Target_Velocity = Plane_Velocity;
        Last_Plane_Position      = Plane_Position;
        Last_Plane_Velocity      = Plane_Velocity;
        Occlusion_Timer          = 0.0;
        Using_PN                 = true;
    else
        Occlusion_Timer          = Occlusion_Timer + Delta_Time;
        Prediction_Time          = min(Occlusion_Timer, 4.0);
        Guidance_Target_Position = Last_Plane_Position + Last_Plane_Velocity * Prediction_Time;
        Guidance_Target_Velocity = Last_Plane_Velocity;
        Using_PN                 = false;
    end

    % --- BOUNDARY REPULSION ---
    Force_Boundary = [0; 0];
    d = max(Missile_Position(1), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(1) = Force_Boundary(1) + Missile_Boundary_Gain * (1/d - 1/Missile_Boundary_Margin) / d^2;
    end
    d = max(Arena_Size - Missile_Position(1), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(1) = Force_Boundary(1) - Missile_Boundary_Gain * (1/d - 1/Missile_Boundary_Margin) / d^2;
    end
    d = max(Missile_Position(2), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(2) = Force_Boundary(2) + Missile_Boundary_Gain * (1/d - 1/Missile_Boundary_Margin) / d^2;
    end
    d = max(Arena_Size - Missile_Position(2), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(2) = Force_Boundary(2) - Missile_Boundary_Gain * (1/d - 1/Missile_Boundary_Margin) / d^2;
    end

    % --- OBSTACLE REPULSION ---
    Force_Repulsive = [0; 0];
    Min_Obs_Dist    = inf;
    for i = 1:Num_Obstacles
        Vec_Away = Missile_Position - Obstacle_Center(1:2,i);
        Dist_Center  = norm(Vec_Away) + 1e-9;
        Dist_Surface = max(Dist_Center - Obstacle_Radius(i), 0.01);
        Min_Obs_Dist = min(Min_Obs_Dist, Dist_Surface);
        if Dist_Surface < Influence_Radius
            Unit_Away  = Vec_Away / Dist_Center;
            Perp_Left  = [-Unit_Away(2);  Unit_Away(1)];
            Perp_Right = [ Unit_Away(2); -Unit_Away(1)];
            To_Target  = Guidance_Target_Position - Missile_Position;
            if dot(To_Target, Perp_Left) >= dot(To_Target, Perp_Right)
                Preferred_Dodge = Perp_Left;
            else
                Preferred_Dodge = Perp_Right;
            end
            Rep_Mag         = Gain_Repulsive * (1/Dist_Surface - 1/Influence_Radius) / Dist_Surface^2;
            Force_Repulsive = Force_Repulsive + Rep_Mag * (0.5 * Unit_Away + 0.5 * Preferred_Dodge);
        end
    end

% --- RELATIVE GEOMETRY ---
Missile_Velocity  = Missile_Speed * [cos(Missile_Heading); sin(Missile_Heading)];
Relative_Position = Guidance_Target_Position - Missile_Position;
Relative_Distance = norm(Relative_Position) + 1e-9;
LOS_Unit = Relative_Position / Relative_Distance;
Relative_Velocity = Guidance_Target_Velocity - Missile_Velocity;

% --- GUIDANCE LAW ---
Navigation_Constant = 2.5;
Desired_Direction = Relative_Position / Relative_Distance;
Current_Direction = [cos(Missile_Heading); sin(Missile_Heading)];

if Using_PN
    % --- PROPORTIONAL NAVIGATION ---
    LOS_Rate = (Relative_Position(1)*Relative_Velocity(2) - Relative_Position(2)*Relative_Velocity(1)) / (Relative_Distance^2);

    Closing_Velocity = -dot(Relative_Velocity, LOS_Unit);
    Closing_Velocity = max(Closing_Velocity, 0);

    A_PN_Magnitude = Navigation_Constant * Closing_Velocity * LOS_Rate;
    A_PN_Direction = [-LOS_Unit(2); LOS_Unit(1)];

    A_PN = A_PN_Magnitude * A_PN_Direction;

    Lead_Gain = 0.8;
    A_Guidance = A_PN + Lead_Gain * Missile_Speed * (Desired_Direction - Current_Direction);
else
   
    % --- PREDICTIVE GUIDANCE WHEN LOS IS BLOCKED ---
    Predictive_Gain = 0.8;

    A_Guidance = Predictive_Gain * Missile_Speed * (Desired_Direction - Current_Direction);
end

% --- APF (OBSTACLE + BOUNDARY AVOIDANCE) ---
A_APF = Force_Repulsive + Force_Boundary;

% Clamp APF to prevent spikes
Max_APF = 80;
if norm(A_APF) > Max_APF
    A_APF = Max_APF * A_APF / norm(A_APF);
end

% --- COMBINE GUIDANCE ---
APF_Weight = max(0, min(1.0, (Influence_Radius - Min_Obs_Dist) / Influence_Radius));
APF_Weight = 1.0 * APF_Weight;   % was 0.6 — increased so APF actually competes with PN
A_Command = A_Guidance + APF_Weight * A_APF;

% Clamp total command to G limit BEFORE extracting turn rate
Max_Total_Accel = Missile_G_Max * 9.81;
if norm(A_Command) > Max_Total_Accel
    A_Command = Max_Total_Accel * A_Command / norm(A_Command);
end

% --- CONVERT ACCELERATION TO TURN RATE ---
A_Lateral = dot(A_Command, [-sin(Missile_Heading); cos(Missile_Heading)]);

Turn_Rate_Command = A_Lateral / Missile_Speed;

% --- LIMIT TURN RATE (G LIMIT) ---
Max_Turn_Rate = Missile_G_Max * 9.81 / Missile_Speed;

Turn_Rate = max(min(Turn_Rate_Command, Max_Turn_Rate), -Max_Turn_Rate);

% --- APPLY TURN ---
Missile_Heading = Missile_Heading + Turn_Rate * Delta_Time;

% --- G LOAD ---
Missile_G = abs(Turn_Rate) * Missile_Speed / 9.81;

% --- POSITION UPDATE ---
Missile_Position(1) = Missile_Position(1) + Missile_Speed * cos(Missile_Heading) * Delta_Time;
Missile_Position(2) = Missile_Position(2) + Missile_Speed * sin(Missile_Heading) * Delta_Time;

Current_Distance = norm([Missile_Position; Missile_Z] - [Plane_Position; Plane_Z]);

if Current_Distance <= Capture_Radius
    Intercept    = true;
    Keep_Running = false;

    Overshoot_Dir_3D = [Missile_Position; Missile_Z] - [Plane_Position; Plane_Z];
    Overshoot_Dir_3D = Overshoot_Dir_3D / (norm(Overshoot_Dir_3D) + 1e-9);
    Missile_Position = Plane_Position + Capture_Radius * Overshoot_Dir_3D(1:2);
    Missile_Z        = Plane_Z        + Capture_Radius * Overshoot_Dir_3D(3);
    fprintf('INTERCEPT at t = %.2f s\n', Current_Time);
end

if Missile_G >= Missile_G_Max && Step > 1 && ~Intercept
    fprintf('MISSILE FAILED: exceeded G limit at t = %.2f s\n', Current_Time);
    Keep_Running = false;
end

    if any(Missile_Position < 0) || any(Missile_Position > Arena_Size)
