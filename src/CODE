function R = Run_Single_Sim(Navigation_Constant, APF_Weight_Scale, Plane_Speed, Missile_Speed, Max_Time, Num_Obstacles_Target, Missile_G_Max, Capture_Radius, Seed, Params)

rng(Seed);   % single seed, one stream, all randomness flows from here

Delta_Time              = Params.Delta_Time;
Plane_Heading           = rand() * 2 * pi;   % draw 1: heading
Plane_Max_Turn_Rate     = Params.Plane_Max_Turn_Rate;
Plane_Noise_Weight      = Params.Plane_Noise_Weight;
Close_Range             = Params.Close_Range;
Jink_Period             = Params.Jink_Period;
Missile_Start           = Params.Missile_Start;
Missile_Boundary_Margin = Params.Missile_Boundary_Margin;
Missile_Boundary_Gain   = Params.Missile_Boundary_Gain;
Boundary_Margin         = Params.Boundary_Margin;
Gain_Repulsive          = Params.Gain_Repulsive;
Influence_Radius        = Params.Influence_Radius;
Arena_Buffer            = Params.Arena_Buffer;
Min_Separation          = Params.Min_Separation;

while true                                    % draw 2+: plane start
    Plane_Start = randi([50, 900], 2, 1);
    while norm(Plane_Start - Missile_Start) < 150
        Plane_Start = randi([50, 900], 2, 1);
    end
    if norm(Plane_Start - Missile_Start) > Min_Separation
        break;
    end
end

Initial_Separation       = norm(Plane_Start - Missile_Start);
Closing_Speed_Estimate   = max(Missile_Speed - Plane_Speed, 0.1);
Estimated_Intercept_Time = Initial_Separation / Closing_Speed_Estimate;
Arena_Size = ceil(max([Missile_Start; Plane_Start])) + ceil(max(Missile_Speed, Plane_Speed) * Estimated_Intercept_Time) + Arena_Buffer;

Obs_Radius_Min = 5; Obs_Radius_Max = 50;
Obstacle_Center = zeros(2, Num_Obstacles_Target);
Obstacle_Radius = zeros(1, Num_Obstacles_Target);
Clearance = 20.0; Count = 0; Attempts = 0;

while Count < Num_Obstacles_Target && Attempts < 5000
    Attempts = Attempts + 1;
    Rad = Obs_Radius_Min + (Obs_Radius_Max - Obs_Radius_Min) * rand();
    Cx  = Rad + (Arena_Size - 2*Rad) * rand();
    Cy  = Rad + (Arena_Size - 2*Rad) * rand();
    C   = [Cx; Cy];
    if norm(C - Missile_Start) < Clearance + Rad, continue; end
    if norm(C - Plane_Start)   < Clearance + Rad, continue; end
    Overlap = false;
    for k = 1:Count
        if norm(C - Obstacle_Center(:,k)) < Rad + Obstacle_Radius(k) + 4
            Overlap = true;
            break;
        end
    end
    if Overlap, continue; end
    Count = Count + 1;
    Obstacle_Center(:,Count) = C;
    Obstacle_Radius(Count)   = Rad;
end
Num_Obstacles = Count;

Missile_Position    = Missile_Start;
Plane_Position      = Plane_Start;
Plane_Velocity      = Plane_Speed * [cos(Plane_Heading); sin(Plane_Heading)];
Plane_Noise_Angle   = 0.0;
Smoothed_Evasion    = [cos(Plane_Heading); sin(Plane_Heading)];
Initial_Vector      = Plane_Start - Missile_Start;
Missile_Heading     = atan2(Initial_Vector(2), Initial_Vector(1));
Last_Plane_Position = Plane_Position;
Last_Plane_Velocity = Plane_Velocity;
Occlusion_Timer     = 0.0;

Max_Steps     = ceil(Max_Time / Delta_Time);
Log_Distance  = nan(1, Max_Steps);
Log_Missile_G = nan(1, Max_Steps);
Log_Missile_X = nan(1, Max_Steps);
Log_Missile_Y = nan(1, Max_Steps);
Log_Plane_X   = nan(1, Max_Steps);
Log_Plane_Y   = nan(1, Max_Steps);

Step         = 0;
Current_Time = 0.0;
Intercept    = false;
Hit_Obstacle = false;
Keep_Running = true;

while Keep_Running && Step < Max_Steps
    Step         = Step + 1;
    Current_Time = Step * Delta_Time;

    Missile_to_Plane_Vector      = Plane_Position - Missile_Position;
    Missile_to_Plane_Distance = norm(Missile_to_Plane_Vector) + 1e-9;
    LOS_Unit = Missile_to_Plane_Vector / Missile_to_Plane_Distance;

    Boundary_Force    = [0;0];
    Boundary_Force(1) = Boundary_Force(1) + max(0, 1 - Plane_Position(1)/Boundary_Margin);
    Boundary_Force(1) = Boundary_Force(1) - max(0, 1 - (Arena_Size-Plane_Position(1))/Boundary_Margin);
    Boundary_Force(2) = Boundary_Force(2) + max(0, 1 - Plane_Position(2)/Boundary_Margin);
    Boundary_Force(2) = Boundary_Force(2) - max(0, 1 - (Arena_Size-Plane_Position(2))/Boundary_Margin);

    Plane_Obstacle_Force = [0;0];
    for i = 1:Num_Obstacles
        Vec_Away = Plane_Position - Obstacle_Center(1:2,i);
        Dist_Center = norm(Vec_Away)+1e-9;
        Dist_Surface = max(Dist_Center - Obstacle_Radius(i), 0.01);
        if Dist_Surface < Influence_Radius
            Plane_Obstacle_Force = Plane_Obstacle_Force + 300*(1/Dist_Surface - 1/Influence_Radius)/Dist_Surface^2 * (Vec_Away/Dist_Center);
        end
    end

    Perp_A = [-LOS_Unit(2); LOS_Unit(1)];
    Perp_B = [ LOS_Unit(2);-LOS_Unit(1)];
    Current_Direction   = [cos(Plane_Heading); sin(Plane_Heading)];
    if dot(Perp_A, Current_Direction) >= dot(Perp_B, Current_Direction)
        Base_Beam_Direction = Perp_A;
    else
        Base_Beam_Direction = Perp_B;
    end
    Jink_Bias         = 0.65 + 0.35*sin(2*pi*Current_Time/Jink_Period);
    Beam_Dir          = Jink_Bias * Base_Beam_Direction / (norm(Jink_Bias * Base_Beam_Direction)+1e-9);
    Away_Weight       = max(0.15, 0.9*(1 - Missile_to_Plane_Distance/Close_Range));
    Plane_Noise_Angle = 0.96*Plane_Noise_Angle + 0.04*randn();
    Noise_Direction         = [cos(Plane_Noise_Angle); sin(Plane_Noise_Angle)];

    Plane_Evasion_Vector               = 0.6*Beam_Dir + Away_Weight*LOS_Unit + Plane_Noise_Weight*Noise_Direction + 1.5*Boundary_Force + 0.6*Plane_Obstacle_Force;
    Smoothed_Evasion = 0.92*Smoothed_Evasion + 0.08*Plane_Evasion_Vector;
    Plane_Desired_Direction              = Smoothed_Evasion / (norm(Smoothed_Evasion)+1e-9);
    Plane_Desired_Heading              = atan2(Plane_Desired_Direction(2), Plane_Desired_Direction(1));
    Plane_Heading_Error              = atan2(sin(Plane_Desired_Heading-Plane_Heading), cos(Plane_Desired_Heading-Plane_Heading));
    Plane_Heading    = Plane_Heading + sign(Plane_Heading_Error)*min(abs(Plane_Heading_Error), Plane_Max_Turn_Rate*Delta_Time);
    Plane_Velocity   = Plane_Speed * [cos(Plane_Heading); sin(Plane_Heading)];
    Plane_Position   = Plane_Position + Plane_Velocity * Delta_Time;

    LOS_Blocked = false;
    for i = 1:Num_Obstacles
        Segment_Vec   = Plane_Position - Missile_Position;
        To_Obstacle   = Obstacle_Center(1:2,i) - Missile_Position;
        Projection = dot(To_Obstacle,Segment_Vec)/(dot(Segment_Vec,Segment_Vec)+1e-9);
        Projection = max(0,min(1,Projection));
        Closest_Point   = Missile_Position + Projection*Segment_Vec;
        if norm(Obstacle_Center(:,i)-Closest_Point) < Obstacle_Radius(i)
            LOS_Blocked = true; break;
        end
    end

    if ~LOS_Blocked
        Guidance_Target_Position = Plane_Position;
        Guidance_Target_Velocity = Plane_Velocity;
        Last_Plane_Position      = Plane_Position;
        Last_Plane_Velocity      = Plane_Velocity;
        Occlusion_Timer          = 0.0;
        Using_PN                 = true;
    else
        Occlusion_Timer          = Occlusion_Timer + Delta_Time;
        Prediction_Time          = min(Occlusion_Timer, 4.0);
        Guidance_Target_Position = Last_Plane_Position + Last_Plane_Velocity * Prediction_Time;
        Guidance_Target_Velocity = Last_Plane_Velocity;
        Using_PN                 = false;
    end

    Missile_Velocity  = Missile_Speed * [cos(Missile_Heading); sin(Missile_Heading)];
    Relative_Position = Guidance_Target_Position - Missile_Position;
    Relative_Distance = norm(Relative_Position) + 1e-9;
    LOS_Unit        = Relative_Position / Relative_Distance;
    Relative_Velocity = Guidance_Target_Velocity - Missile_Velocity;
    Closing_Velocity  = max(-dot(Relative_Velocity, LOS_Unit), 0);

    Log_Missile_X(Step) = Missile_Position(1);
    Log_Missile_Y(Step) = Missile_Position(2);
    Log_Plane_X(Step)   = Plane_Position(1);
    Log_Plane_Y(Step)   = Plane_Position(2);

    if Using_PN
        LOS_Rate    = (Relative_Position(1)*Relative_Velocity(2) - Relative_Position(2)*Relative_Velocity(1)) / Relative_Distance^2;
        A_PN        = Navigation_Constant * Closing_Velocity * LOS_Rate * [-LOS_Unit(2); LOS_Unit(1)];
        Desired_Direction = Relative_Position / Relative_Distance;
        Current_Direction = [cos(Missile_Heading); sin(Missile_Heading)];
        A_Guidance  = A_PN + 0.8 * Missile_Speed * (Desired_Direction - Current_Direction);
    else
        Desired_Direction = Relative_Position / Relative_Distance;
Current_Direction = [cos(Missile_Heading); sin(Missile_Heading)];
A_Guidance = 0.8 * Missile_Speed * (Desired_Direction - Current_Direction);
    end

    Force_Boundary = [0;0];
    d = max(Missile_Position(1), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(1) = Force_Boundary(1) + Missile_Boundary_Gain*(1/d - 1/Missile_Boundary_Margin)/d^2;
    end
    d = max(Arena_Size-Missile_Position(1), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(1) = Force_Boundary(1) - Missile_Boundary_Gain*(1/d - 1/Missile_Boundary_Margin)/d^2;
    end
    d = max(Missile_Position(2), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(2) = Force_Boundary(2) + Missile_Boundary_Gain*(1/d - 1/Missile_Boundary_Margin)/d^2;
    end
    d = max(Arena_Size-Missile_Position(2), 0.01);
    if d < Missile_Boundary_Margin
        Force_Boundary(2) = Force_Boundary(2) - Missile_Boundary_Gain*(1/d - 1/Missile_Boundary_Margin)/d^2;
    end

    Force_Repulsive = [0;0];
    Min_Obs_Dist    = inf;
    for i = 1:Num_Obstacles
        Vec_Away = Missile_Position - Obstacle_Center(1:2,i);
        Dist_Center  = norm(Vec_Away) + 1e-9;
        Dist_Surface = max(Dist_Center - Obstacle_Radius(i), 0.01);
        Min_Obs_Dist = min(Min_Obs_Dist, Dist_Surface);
        Effective_Influence = Influence_Radius * 1.5;
        if Dist_Surface < Effective_Influence
            Unit_Away = Vec_Away / Dist_Center;
            Perp_Left = [-Unit_Away(2);  Unit_Away(1)];
            Perp_Right = [ Unit_Away(2); -Unit_Away(1)];
            To_Target = Guidance_Target_Position - Missile_Position;
            if dot(To_Target, Perp_Left) >= dot(To_Target, Perp_Right)
                Dodge = Perp_Left;
            else
                Dodge = Perp_Right;
            end
            Rep_Mag         = Gain_Repulsive * 1.5 * (1/Dist_Surface - 1/Effective_Influence) / Dist_Surface^2;
            Force_Repulsive = Force_Repulsive + Rep_Mag*(0.5*Unit_Away + 0.5*Dodge);
        end
    end

    % Obstacle collision check
    for i = 1:Num_Obstacles
        if norm(Missile_Position - Obstacle_Center(1:2,i)) <= Obstacle_Radius(i)
            Hit_Obstacle = true; Keep_Running = false; break;
        end
    end

    A_APF = Force_Repulsive + Force_Boundary;
    if norm(A_APF) > 80
        A_APF = 80 * A_APF / norm(A_APF);
    end

    % Wider detection + stronger repulsion for batch sim
    if Min_Obs_Dist < Influence_Radius * 1.5
        APF_W = APF_Weight_Scale * (1.0 + (Influence_Radius * 1.5 - Min_Obs_Dist) / (Influence_Radius * 1.5));
        APF_W = min(APF_W, 3.0);   % cap to prevent runaway
    else
        APF_W = 0;
    end

    A_Command = A_Guidance + APF_W * A_APF;
    Max_Total_Accel = Missile_G_Max * 9.81;

    if norm(A_Command) > Max_Total_Accel
        A_Command = Max_Total_Accel * A_Command / norm(A_Command);
    end

    A_Lateral         = dot(A_Command, [-sin(Missile_Heading); cos(Missile_Heading)]);
    Turn_Rate_Command = A_Lateral / Missile_Speed;
    Max_Turn_Rate     = Missile_G_Max * 9.81 / Missile_Speed;
    Turn_Rate         = max(min(Turn_Rate_Command, Max_Turn_Rate), -Max_Turn_Rate);
    Missile_Heading   = Missile_Heading + Turn_Rate * Delta_Time;
    Missile_G         = abs(Turn_Rate) * Missile_Speed / 9.81;

    Missile_Position(1) = Missile_Position(1) + Missile_Speed*cos(Missile_Heading)*Delta_Time;
    Missile_Position(2) = Missile_Position(2) + Missile_Speed*sin(Missile_Heading)*Delta_Time;

    Current_Distance    = norm(Missile_Position - Plane_Position);
    Log_Distance(Step)  = Current_Distance;
    Log_Missile_G(Step) = Missile_G;

    if Current_Distance <= Capture_Radius
        Intercept = true; Keep_Running = false;
    end
    if any(Missile_Position < 0) || any(Missile_Position > Arena_Size)
        Keep_Running = false;
    end
    if Missile_G >= Missile_G_Max && Step > 1 && ~Intercept
        Keep_Running = false;
    end
end

R.Intercept      = Intercept;
R.Hit_Obstacle   = Hit_Obstacle;
R.Final_Distance = Log_Distance(Step);
R.Max_G          = max(Log_Missile_G, [], 'omitnan');
R.Duration       = Current_Time;
R.Missile_X      = Log_Missile_X(1:Step);
R.Missile_Y      = Log_Missile_Y(1:Step);
R.Plane_X        = Log_Plane_X(1:Step);
R.Plane_Y        = Log_Plane_Y(1:Step);
R.Obs_Center     = Obstacle_Center;
R.Obs_Radius     = Obstacle_Radius;
end

function Flags = FlagToggleGUI(Flags)

Fig = uifigure('Name', 'Simulation Toggles', 'Position', [600 250 420 430], 'Resize', 'on');

fields = fieldnames(Flags);
Num_Fields = length(fields);

Grid = uigridlayout(Fig, [Num_Fields + 1, 2]);
Grid.RowHeight = [repmat({32}, 1, Num_Fields), {45}];
Grid.ColumnWidth = {'1x', 90};
Grid.Padding = [15 15 15 15];
Grid.RowSpacing = 6;

for i = 1:Num_Fields
    Field_Name = fields{i};

    Label = uilabel(Grid, 'Text', strrep(Field_Name, '_', ' '), 'FontSize', 12);

    Label.Layout.Row = i;
    Label.Layout.Column = 1;

    Switch = uiswitch(Grid, 'slider', 'Items', {'false', 'true'}, 'Value', string(Flags.(Field_Name)));

    Switch.Layout.Row = i;
    Switch.Layout.Column = 2;

    Switch.ValueChangedFcn = @(src, event) updateFlag(src, Field_Name);
end

Run_Button = uibutton(Grid, 'Text', 'Save & Run', 'ButtonPushedFcn', @(src,event) uiresume(Fig));

Run_Button.Layout.Row = Num_Fields + 1;
Run_Button.Layout.Column = [1 2];

uiwait(Fig);

if isvalid(Fig)
    save('SimFlags.mat', 'Flags');
    delete(Fig);
end

    function updateFlag(src, name)
    Flags.(name) = strcmp(src.Value, 'true');
end

end


function Vout = TransformSAMSTL2D(V, Position, Heading, Scale)

V = V(:, [1 3 2]);   

V = V * Scale;

R = [cos(Heading), -sin(Heading), 0;
    sin(Heading),  cos(Heading), 0;
    0,             0,            1];

V = V * R';

Vout = V + [Position(1), Position(2), 0];

end
