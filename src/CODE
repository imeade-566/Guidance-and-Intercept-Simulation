            for r = 1:Runs_Per_Combo
                R = Run_Single_Sim(Nav_Values(ni), APF_Values(ai), Plane_Speed, Missile_Speed, Max_Time, Num_Obstacles, Missile_G_Max, Capture_Radius, Run_Seeds(ni, ai, r), Params);
                Successes    = Successes  + R.Intercept;
