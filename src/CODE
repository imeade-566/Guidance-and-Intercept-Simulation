Log_Plane_Heading   = nan(1, Step);
Log_Missile_Heading = nan(1, Step);
Log_Beam_Angle      = nan(1, Step);
Log_Plane_Speed_Mag = nan(1, Step);
Log_Closing_Rate    = nan(1, Step);
Log_LOS_Rate        = nan(1, Step);
Log_Accel_Demand    = nan(1, Step);
Log_Missile_G   = Log_Missile_G(1:Step);

%% ========================================================================
% SECTION 6: COMPUTE DERIVED QUANTITIES
% =========================================================================

for k = 2:Step
    los      = [Log_Plane_X(k)   - Log_Missile_X(k);   Log_Plane_Y(k)   - Log_Missile_Y(k)];
    los_prev = [Log_Plane_X(k-1) - Log_Missile_X(k-1); Log_Plane_Y(k-1) - Log_Missile_Y(k-1)];

    los_angle      = atan2(los(2),      los(1));
    los_angle_prev = atan2(los_prev(2), los_prev(1));
    Log_LOS_Angle(k) = rad2deg(los_angle);

    los_rate        = atan2(sin(los_angle - los_angle_prev), cos(los_angle - los_angle_prev)) / Delta_Time;
    Log_LOS_Rate(k) = rad2deg(los_rate);

    dp = [Log_Plane_X(k)   - Log_Plane_X(k-1);   Log_Plane_Y(k)   - Log_Plane_Y(k-1)];
    dm = [Log_Missile_X(k) - Log_Missile_X(k-1); Log_Missile_Y(k) - Log_Missile_Y(k-1)];

    plane_spd              = norm(dp);
    Log_Plane_Speed_Mag(k) = plane_spd / Delta_Time;

    if plane_spd > 0.01
        ph                   = atan2(dp(2), dp(1));
        Log_Plane_Heading(k) = rad2deg(ph);
        beam                 = atan2(sin(ph - los_angle), cos(ph - los_angle));
        Log_Beam_Angle(k)    = abs(rad2deg(beam));
    end

    if norm(dm) > 0.01
        mh                     = atan2(dm(2), dm(1));
        Log_Missile_Heading(k) = rad2deg(mh);
        prev_mh                = deg2rad(Log_Missile_Heading(max(k-1, 2)));
        turn_rate              = atan2(sin(mh - prev_mh), cos(mh - prev_mh)) / Delta_Time;
        Log_Accel_Demand(k)    = abs(turn_rate) * Missile_Speed;
    end

    los_unit            = los / (norm(los) + 1e-9);
    rel_vel             = dp/Delta_Time - dm/Delta_Time;
    Log_Closing_Rate(k) = -dot(rel_vel, los_unit);
end

