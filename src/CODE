    rng('shuffle');
    Run_Seeds = randi(1e6, Num_Nav, Num_APF, Runs_Per_Combo);
    fprintf('Seeds: '); fprintf('%d ', Run_Seeds); fprintf('\n');    
    for ni = 1:Num_Nav
        for ai = 1:Num_APF
            Successes  = 0;
            Collisions = 0;
            G_Vals     = zeros(1, Runs_Per_Combo);
            Dist_Vals  = zeros(1, Runs_Per_Combo);
